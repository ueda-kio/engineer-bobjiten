{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "engineer-bobjiten",
  "compatibility_date": "2026-08-22",
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Required: the SPA does client-side routing, so unknown paths must serve index.html.
    "not_found_handling": "single-page-application",
    // ...which would also swallow the websocket upgrade, since it answers every
    // non-asset path with index.html. This sends /ws to the Worker instead.
    "run_worker_first": ["/ws"],
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }],
  },
  // SQLite-backed classes are the only kind the free plan allows.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
}
